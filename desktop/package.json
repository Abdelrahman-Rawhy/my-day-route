{
  "name": "yawmi-desktop",
  "productName": "Yawmi",
  "version": "1.0.0",
  "description": "Yawmi (يومي) for Windows",
  "author": "Rawhy",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rawhy.yawmi",
    "productName": "Yawmi",
    "artifactName": "Yawmi-Setup.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "wpreload.js", "widgets/**/*", "tray.png", "build/icon.png", "www/**/*"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "extraResources": [{ "from": "bin/pinhelper.exe", "to": "pinhelper.exe" }],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yawmi",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
