<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layoutDirection="rtl" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="8dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_card_prayer">
        <TextView android:id="@+id/w_prayer_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FFFBBF24" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <Chronometer android:id="@+id/w_prayer_cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_card_step">
        <TextView android:id="@+id/w_step_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FF22D3EE" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <Chronometer android:id="@+id/w_step_cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
