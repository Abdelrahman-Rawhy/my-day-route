<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="10dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_lbl_prayer" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/w_next_prayer" android:textColor="#FFFBBF24" android:textSize="13sp" android:textStyle="bold"/>
    <TextView android:id="@+id/w_prayer_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
    <Chronometer android:id="@+id/w_prayer_cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="34sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
    <TextView android:id="@+id/w_prayer_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#99FFFFFF" android:textSize="15sp" android:layout_marginTop="2dp"/>
</LinearLayout>
