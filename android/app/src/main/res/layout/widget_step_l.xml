<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_flip" android:layout_width="match_parent" android:layout_height="match_parent"
    android:inAnimation="@anim/w_in" android:outAnimation="@anim/w_out">
    <LinearLayout android:id="@+id/w_step_body" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/w_s_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="" android:textColor="#FF22D3EE" android:textSize="11sp" android:textStyle="bold" android:textDirection="firstStrong"/>
                <TextView android:id="@+id/w_s_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" android:textColor="#B3FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/w_s_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textDirection="firstStrong"
                        android:text="" android:textColor="#FFFFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
                    <TextView android:id="@+id/w_s_pts" android:layout_width="match_parent" android:layout_height="wrap_content" android:textDirection="firstStrong"
                        android:text="" android:textColor="#FFFBBF24" android:textSize="13sp"/>
                </LinearLayout>
                <ImageView android:id="@+id/w_s_check" android:layout_width="62dp" android:layout_height="62dp" android:layout_marginStart="10dp"
                    android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_w_check" android:contentDescription="done" android:background="@drawable/widget_check_btn"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/w_s_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp"
                android:layout_marginTop="10dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress"/>
            <TextView android:id="@+id/w_s_uplabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textDirection="firstStrong"
                android:text="" android:textColor="#99FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:id="@+id/w_r1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/widget_row">
                <TextView android:id="@+id/w_r1_n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textDirection="firstStrong"
                    android:text="" android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/w_r1_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="" android:textColor="#99FFFFFF" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/w_r2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/widget_row">
                <TextView android:id="@+id/w_r2_n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textDirection="firstStrong"
                    android:text="" android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/w_r2_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="" android:textColor="#99FFFFFF" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/w_r3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/widget_row">
                <TextView android:id="@+id/w_r3_n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textDirection="firstStrong"
                    android:text="" android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/w_r3_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="" android:textColor="#99FFFFFF" android:textSize="12sp"/>
            </LinearLayout>
            </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"
        android:padding="12dp" android:background="@drawable/widget_celebrate_bg">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎉" android:textSize="34sp"/>
        <TextView android:id="@+id/w_c_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_c_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#E6FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_c_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</ViewFlipper>
