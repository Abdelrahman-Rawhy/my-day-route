<?xml version="1.0" encoding="utf-8"?>
<!-- Glass: a light dark tint so text stays readable, a soft white sheen, and a bright hairline edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59121630"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="300" android:startColor="#2EFFFFFF" android:centerColor="#0FFFFFFF" android:endColor="#1A9C88FF" android:type="linear"/>
            <corners android:radius="26dp"/>
            <stroke android:width="1dp" android:color="#47FFFFFF"/>
        </shape>
    </item>
</layer-list>
